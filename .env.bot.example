# Salin menjadi .env.bot.local dan isi nilainya. Jangan commit file yang berisi token.
CELOE_TIMELINE_URL=https://lms.telkomuniversity.ac.id/calendar/view.php
CELOE_BOT_ENDPOINT=https://YOUR-VERCEL-DOMAIN/api/celoe-timeline-sync
CELOE_BOT_TOKEN=buat-token-panjang-acak-yang-sama-dengan-environment-variable-di-Vercel
CELOE_POLL_MINUTES=5
